# Django Backend Configuration Template
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Payment Gateway Configuration
PAYMENT_ENV=sandbox
ABA_ENABLED=True
ABA_MERCHANT_ID=foodgo_merchant_01
ABA_API_KEY=mock_aba_api_key
ABA_API_SECRET=mock_aba_secret_key
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase

ACLEDA_ENABLED=True
ACLEDA_MERCHANT_ID=acleda_foodgo_01
ACLEDA_API_KEY=mock_acleda_api_key
ACLEDA_API_SECRET=mock_acleda_secret_key

# National Bank of Cambodia (NBC) Bakong Open API
BAKONG_ENABLED=True
BAKONG_API_TOKEN=your_bakong_open_api_token_here
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5
BAKONG_ACCOUNT_ID=foodgo@bakong
BAKONG_MERCHANT_NAME=FoodGo Restaurant
BAKONG_MERCHANT_CITY=Phnom Penh
