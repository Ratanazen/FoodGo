# ==========================================
# FoodGo Environment Configuration Template
# ==========================================

# Django Core
DJANGO_DEBUG=False
SECRET_KEY=foodgo-production-secret-key-replace-with-your-own-random-string-12345
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,.vercel.app,food-go-app.vercel.app,.onrender.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://food-go-app.vercel.app,https://foodgo-53pl.onrender.com

# Database (PostgreSQL 15 for production / SQLite dev fallback if empty)
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodgo

# Redis & Channels (WebSockets)
REDIS_URL=redis://localhost:6379/0

# Production Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Google Maps API
GOOGLE_MAPS_API_KEY=AIzaSyC3asDbdqC77DpPZt8DSttWJ2r9hLGT2PA

# Payment Gateways (Cambodian Fintech KHQR & NBC Standards)
PAYMENT_ENV=sandbox
PAYMENT_WEBHOOK_SECRET=your_production_webhook_secret_here

ABA_ENABLED=True
ABA_API_KEY=your_aba_payway_api_key_here
ABA_API_SECRET=your_aba_payway_secret_key_here
ABA_MERCHANT_ID=your_aba_merchant_id_here
ABA_MERCHANT_NAME=FoodGo Restaurant
ABA_MERCHANT_CITY=Phnom Penh
ABA_CALLBACK_URL=http://127.0.0.1:8000/api/payments/aba/callback/

ACLEDA_ENABLED=True
ACLEDA_API_KEY=your_acleda_api_key_here
ACLEDA_API_SECRET=your_acleda_api_secret_here
ACLEDA_MERCHANT_ID=your_acleda_merchant_id_here
ACLEDA_MERCHANT_NAME=FoodGo Restaurant
ACLEDA_MERCHANT_CITY=Phnom Penh
ACLEDA_CALLBACK_URL=http://127.0.0.1:8000/api/payments/acleda/callback/

BAKONG_ENABLED=True
BAKONG_ACCOUNT_ID=merchant@acleda
BAKONG_MERCHANT_NAME=FoodGo Restaurant
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_TOKEN=your_nbc_bakong_token_here

# MongoDB Atlas (NoSQL Document Store, Audit Logs, Realtime Events)
MONGODB_USERNAME=your_mongodb_username_here
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net
MONGODB_DB_NAME=foodgo
