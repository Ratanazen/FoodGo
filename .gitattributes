# Normalize line endings across Linux, macOS, Windows, and Docker builds
* text=auto eol=lf

# Shell and automation scripts must remain LF so Linux/macOS/Docker containers never fail with CRLF
*.sh text eol=lf
*.bash text eol=lf

# Application source, config, templates, and CI definitions
*.py text eol=lf
*.dart text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf

# Windows batch and PowerShell helpers keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary
*.keystore binary
*.jks binary
