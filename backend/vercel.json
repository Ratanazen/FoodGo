{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{staticfiles/**,media/**,tests*/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ]
}

