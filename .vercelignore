# Vercel deployment exclusions
# Prevents large mobile platforms, virtual environments, and caches
# from inflating deployment uploads. Backend lambda exclusions are managed
# via functions.excludeFiles in vercel.json.

.venv/
backend/venv/
.git/
.github/
android/
ios/
windows/
macos/
linux/
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
*.db
.tempmediaStorage/

