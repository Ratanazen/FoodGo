# ==============================================================================
# FoodGo Backend — Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
SECRET_KEY=foodgo-production-secret-key-replace-with-your-own-random-string-12345
DJANGO_ALLOWED_HOSTS=api.foodgo.app,foodgo-backend-a.vercel.app,foodgo-backend-b.vercel.app,.vercel.app,127.0.0.1,localhost,0.0.0.0,.onrender.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://api.foodgo.app,https://food-go-app.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://api.foodgo.app,https://food-go-app.vercel.app,https://foodgo-53pl.onrender.com

# ------------------------------------------------------------------------------
# 2. Dual-Backend Shared Database & Redis Cache
# ------------------------------------------------------------------------------
# Both Vercel Project A and Vercel Project B connect to the SAME persistent PostgreSQL database
DATABASE_URL=postgresql://username:password@ep-foodgo-shared.neon.tech/foodgo_production?sslmode=require
# Shared Redis instance (e.g. Upstash / Redis Cloud) for cross-instance caching and token blacklist
REDIS_URL=rediss://default:token@shared-foodgo-redis.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Dual-Backend Vercel & Cloudflare Load Balancing Origins
# ------------------------------------------------------------------------------
# Project A (Primary origin): foodgo-backend-a.vercel.app
# Project B (Secondary origin / Active-Passive): foodgo-backend-b.vercel.app
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_LB_HOSTNAME=api.foodgo.app

# ------------------------------------------------------------------------------
# 2. Payment Gateway Environment & Universal Webhook Security
# ------------------------------------------------------------------------------
# Set to 'sandbox' for staging/test environments or 'production' for live payments
PAYMENT_ENV=sandbox

# Secret token used to verify inbound provider webhook signatures (X-Webhook-Secret / X-Signature)
# Must be set to a strong random token in production to protect callback endpoints
PAYMENT_WEBHOOK_SECRET=foodgo_webhook_secure_key_2026

# ------------------------------------------------------------------------------
# 3. National Bank of Cambodia (NBC) Bakong KHQR Open API
# ------------------------------------------------------------------------------
BAKONG_ENABLED=True
# Production: https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5
# UAT / Sandbox: https://api-bakong-sandbox.nbc.gov.kh/v1/check_transaction_by_md5
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5
# Official Bakong Developer Bearer JWT Token (Required for live status checks)
BAKONG_API_TOKEN=your_bakong_developer_jwt_token_here
# Registered Bakong Individual / Merchant Account ID
BAKONG_ACCOUNT_ID=sonar_seang@bkrt
BAKONG_MERCHANT_NAME=FoodGo Restaurant
BAKONG_MERCHANT_CITY=Phnom Penh

# ------------------------------------------------------------------------------
# 4. ABA PayWay / ABA KHQR Gateway
# ------------------------------------------------------------------------------
ABA_ENABLED=True
# ABA Merchant Identifier provided during PayWay onboarding
ABA_MERCHANT_ID=foodgo_merchant_01
ABA_API_KEY=your_aba_payway_api_key
ABA_API_SECRET=your_aba_payway_secret_key_for_hmac_sha512
# Sandbox API endpoint
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
# Public URL for ABA server-to-server webhook notifications
ABA_CALLBACK_URL=https://foodgo-53pl.onrender.com/api/payments/aba/callback/

# ------------------------------------------------------------------------------
# 5. ACLEDA Bank x-Pay Gateway
# ------------------------------------------------------------------------------
ACLEDA_ENABLED=True
ACLEDA_MERCHANT_ID=acleda_foodgo_01
ACLEDA_API_KEY=your_acleda_api_key
ACLEDA_API_SECRET=your_acleda_api_secret
# Sandbox API endpoint
ACLEDA_API_URL=https://api.acledabank.com.kh/sandbox/v1/x-pay/partner/merchant/payment
# Public URL for ACLEDA webhook callbacks
ACLEDA_CALLBACK_URL=https://foodgo-53pl.onrender.com/api/payments/acleda/callback/

# ------------------------------------------------------------------------------
# 6. Legacy / Optional Providers
# ------------------------------------------------------------------------------
# Note: Stripe is installed in dependencies for legacy compatibility, but Cambodian
# bank payments use NBC Bakong KHQR, ABA PayWay, and ACLEDA.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 7. Cambodian SMS Gateway & Phone OTP Verification
# ------------------------------------------------------------------------------
# Provider selection: 'simosms' (smscambodia.com), 'weums' (weums365.com), or 'test' (isolated test suite)
SMS_PROVIDER=simosms

# SimoSMS (smscambodia.com / ViHaT Group Cambodia) Production Credentials
SMS_API_KEY=your_simosms_api_key_here
SMS_API_SECRET=your_simosms_api_secret_here
SMS_SENDER_ID=FoodGo
SMS_API_BASE_URL=https://smscambodia.com/smsapi

# Alternative Provider: WeUMS (weums365.com)
# WEUMS_API_KEY=your_weums_api_key_here
# WEUMS_API_URL=https://weums365.com/api/v1/messages

# OTP Cryptography & Security Rate Limits
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
